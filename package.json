{
  "name": "react-native-lander",
  "version": "0.1.1",
  "description": "Deep linking without the fuss: receive, resolve and create Lander links in React Native apps.",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./app.plugin.js": "./app.plugin.js",
    "./package.json": "./package.json"
  },
  "files": [
    "CHANGELOG.md",
    "src",
    "lib",
    "android",
    "ios",
    "plugin",
    "app.plugin.js",
    "*.podspec",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!plugin/*.test.js",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "build": "bob build",
    "prepare": "bob build",
    "clean": "rm -rf lib android/build ios/build"
  },
  "keywords": [
    "react-native",
    "deep-linking",
    "deferred-deep-linking",
    "universal-links",
    "app-links",
    "lander",
    "ios",
    "android",
    "expo"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SwiftwareIO/lander_react_native.git"
  },
  "author": "Lander (https://golander.link)",
  "license": "MIT",
  "homepage": "https://github.com/SwiftwareIO/lander_react_native#readme",
  "bugs": {
    "url": "https://github.com/SwiftwareIO/lander_react_native/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "engines": {
    "node": ">= 20"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.76",
    "expo": "*"
  },
  "peerDependenciesMeta": {
    "expo": {
      "optional": true
    }
  },
  "devDependencies": {
    "@expo/config-plugins": "^58.0.10",
    "@react-native/babel-preset": "0.88.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.0",
    "jest": "^29.7.0",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-builder-bob": "^0.44.1",
    "typescript": "^6.0.3"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "RNLanderSpec",
    "type": "modules",
    "jsSrcsDir": "src/native",
    "android": {
      "javaPackageName": "link.lander.reactnative"
    }
  }
}
